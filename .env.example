# Required
ANTHROPIC_API_KEY=
# Random string used to sign generation sessions (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# Free-tier limits
DAILY_BUDGET_USD=20
FREE_COURSES_PER_IP_PER_DAY=1

# Shared counters across serverless instances (required in production on Vercel)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Share links (Vercel Blob). Without it the site offers download only.
BLOB_READ_WRITE_TOKEN=

# Optional model tuning
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# PRICE_INPUT_PER_MTOK=4
# PRICE_OUTPUT_PER_MTOK=20
